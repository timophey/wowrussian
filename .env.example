# Application
APP_NAME=WowRussian Analyzer
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_SECRET_KEY=your-admin-secret-key-change-this

# Frontend
FRONTEND_PORT=3000

# Database
# Choose one of the following:
#
# SQLite (default, good for development):
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
#
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://wowrussian:wowrussian_password@postgres:5432/wowrussian
#
# MySQL/MariaDB (alternative for production):
# DATABASE_URL=mysql+aiomysql://wowrussian:wowrussian_password@mysql:3306/wowrussian
#
# For local development without Docker, use:
# PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/wowrussian
# MySQL: mysql+aiomysql://user:password@localhost:3306/wowrussian
#
# Default (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
DATABASE_URL=postgresql+asyncpg://wowrussian:wowrussian_password@postgres:5432/wowrussian


# PostgreSQL credentials (used in docker-compose)
POSTGRES_USER=wowrussian
POSTGRES_PASSWORD=wowrussian_password
POSTGRES_DB=wowrussian

# MySQL credentials (used in docker-compose)
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=wowrussian
MYSQL_USER=wowrussian
MYSQL_PASSWORD=wowrussian_password

# Redis
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage
STORAGE_PATH=/app/storage
UPLOAD_MAX_SIZE=10485760

# CORS
# IMPORTANT: If you change FRONTEND_PORT, update this list accordingly
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Crawler
CRAWLER_USER_AGENT=WowRussianBot/1.0
CRAWLER_DELAY=1
CRAWLER_TIMEOUT=30
CRAWLER_MAX_PAGES=1000

# Dictionary (law №168-FZ compliance)
DICTIONARY_PATH=/app/dictionaries/russian_words.txt
DICTIONARY_URL=https://raw.githubusercontent.com/danakt/russian-words/master/russian.txt
AUTO_DOWNLOAD_DICTIONARY=True

# 168fz Integration (enhanced foreign word detection)
# Set to False to disable 168fz and use only local dictionary
USE_FZ168=True
# URL of the 168fz service (use 'fz168' when running in docker-compose, or host IP if running externally)
FZ168_URL=http://fz168:8000
# Request timeout in seconds
FZ168_TIMEOUT=10
# Number of retry attempts on failure
FZ168_RETRY_ATTEMPTS=3

# 168fz Admin Key (only needed if you want to use admin features of 168fz)
FZ168_ADMIN_KEY=